<UserControl x:Class="TypeWhisper.Plugin.Sarvam.SarvamSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="0,8">
        <!-- API Key Section -->
        <TextBlock Text="Sarvam API Key" FontWeight="SemiBold" Margin="0,0,0,4" />
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <PasswordBox x:Name="ApiKeyBox" PasswordChanged="OnPasswordChanged" VerticalContentAlignment="Center" Height="30" />
            <Button Grid.Column="1" Margin="8,0,0,0" Padding="14,4" Content="Save &amp; Verify"
                    Click="OnTestClick" x:Name="TestButton" Height="30" />
        </Grid>
        <TextBlock x:Name="StatusText" Margin="0,0,0,12" FontSize="12" />

        <Separator Margin="0,4,0,12" />

        <!-- Mode Section -->
        <TextBlock Text="Output Format / Style" FontWeight="SemiBold" Margin="0,0,0,4" />
        <ComboBox x:Name="ModeComboBox" SelectionChanged="OnModeSelectionChanged" Margin="0,0,0,4" Height="28">
            <ComboBoxItem Content="Hinglish / Roman Script (Texting Style)" Tag="translit" />
            <ComboBoxItem Content="Native Devanagari / Indic Script" Tag="transcribe" />
            <ComboBoxItem Content="Translate to English Meaning" Tag="translate" />
            <ComboBoxItem Content="CodeMix (Indic + English Words)" Tag="codemix" />
        </ComboBox>
        <TextBlock x:Name="ModeHelpText" FontSize="11" Foreground="Gray" Margin="0,0,0,12" TextWrapping="Wrap" />

        <Separator Margin="0,4,0,12" />

        <!-- Language Section -->
        <TextBlock Text="Spoken Language" FontWeight="SemiBold" Margin="0,0,0,4" />
        <ComboBox x:Name="LanguageComboBox" SelectionChanged="OnLanguageSelectionChanged" Margin="0,0,0,4" Height="28">
            <ComboBoxItem Content="Hindi (hi-IN) - Recommended for Hinglish" Tag="hi-IN" />
            <ComboBoxItem Content="Auto-Detect (unknown)" Tag="unknown" />
            <ComboBoxItem Content="Indian English (en-IN)" Tag="en-IN" />
            <ComboBoxItem Content="Bengali (bn-IN)" Tag="bn-IN" />
            <ComboBoxItem Content="Tamil (ta-IN)" Tag="ta-IN" />
            <ComboBoxItem Content="Telugu (te-IN)" Tag="te-IN" />
            <ComboBoxItem Content="Marathi (mr-IN)" Tag="mr-IN" />
            <ComboBoxItem Content="Gujarati (gu-IN)" Tag="gu-IN" />
            <ComboBoxItem Content="Kannada (kn-IN)" Tag="kn-IN" />
            <ComboBoxItem Content="Malayalam (ml-IN)" Tag="ml-IN" />
            <ComboBoxItem Content="Punjabi (pa-IN)" Tag="pa-IN" />
            <ComboBoxItem Content="Follow TypeWhisper Language" Tag="follow-typewhisper" />
        </ComboBox>
        <TextBlock Text="Locking to Hindi (hi-IN) delivers highest accuracy when dictating Hinglish." FontSize="11" Foreground="Gray" Margin="0,0,0,12" />

        <Separator Margin="0,4,0,12" />

        <!-- Model Section -->
        <TextBlock Text="Model Selection" FontWeight="SemiBold" Margin="0,0,0,4" />
        <ComboBox x:Name="ModelComboBox" SelectionChanged="OnModelSelectionChanged" Margin="0,0,0,12" Height="28">
            <ComboBoxItem Content="Saaras v4 (Recommended - Latest transliteration)" Tag="saaras:v4" />
            <ComboBoxItem Content="Saaras v3 (Fast)" Tag="saaras:v3" />
            <ComboBoxItem Content="Saaras v2.5 (Legacy)" Tag="saaras:v2.5" />
        </ComboBox>

        <Separator Margin="0,4,0,12" />

        <!-- About & Attribution Section -->
        <Border Background="#0D000000" CornerRadius="8" Padding="12" Margin="0,4,0,8">
            <StackPanel>
                <TextBlock Text="About &amp; Attribution" FontWeight="Bold" Margin="0,0,0,4" />
                <TextBlock Text="Crafted with ❤️ by the good folks at TalkXO in India 🇮🇳 (hello.talkxo.com)" FontWeight="SemiBold" Margin="0,0,0,2" />
                <TextBlock Text="Originally developed as an internal tool for our team at TalkXO, and shared openly with the community as an enthusiastic enabler for Indic voice workflows." FontSize="11" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,8" />
                <TextBlock Text="Trademarks &amp; Disclaimer: Sarvam AI and Saaras are trademarks of Sarvam AI Technologies Pvt. Ltd. This plugin is an independent community integration. We hold no claim or rights over the Sarvam brand or models. Transcription requests are processed directly against Sarvam AI's official REST API using your personal API key." FontSize="10" Foreground="#888888" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
